# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///zgoogies.db

# Email Configuration (Yahoo)
# App password required — generate at: https://myaccount.yahoo.com/security (Manage app passwords)
MAIL_SERVER=smtp.mail.yahoo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=zgoogiesgame@yahoo.com
MAIL_PASSWORD=your-yahoo-app-password
MAIL_DEFAULT_SENDER=zgoogiesgame@yahoo.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google reCAPTCHA v2
